{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .reviews-carousel-bg-{{ section.id }} {
    {% assign overlay_color = section.settings.bg_overlay_color | default: section.settings.background_color %}
    {% assign overlay_op = section.settings.bg_overlay_opacity | divided_by: 100.0 %}
    {% assign r = overlay_color.red %}
    {% assign g = overlay_color.green %}
    {% assign b = overlay_color.blue %}
    
    {% if section.settings.bg_image != blank %}
      background: linear-gradient(rgba({{ r }}, {{ g }}, {{ b }}, {{ overlay_op }}), rgba({{ r }}, {{ g }}, {{ b }}, {{ overlay_op }})), url('{{ section.settings.bg_image | image_url: width: 2000 }}') center center / cover no-repeat {% if section.settings.enable_fixed_bg %}fixed{% endif %} !important;
    {% else %}
      background: {{ section.settings.background_color }};
    {% endif %}
  }

  .reviews-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .reviews-subtitle-{{ section.id }} {
    font-size: 1.2rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    font-weight: 700;
    margin-bottom: 0.8rem;
  }

  .reviews-title-{{ section.id }} {
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 4vw, 4rem);
    font-weight: 500;
    color: #1a1a1a;
    margin: 0 0 1.2rem;
    line-height: 1.2;
  }

  .reviews-heart-divider-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: {{ section.settings.accent_color }};
    margin-top: 0.5rem;
  }

  .reviews-heart-divider-{{ section.id }}::before,
  .reviews-heart-divider-{{ section.id }}::after {
    content: '';
    display: block;
    height: 1px;
    width: 60px;
    background: linear-gradient(90deg, transparent, {{ section.settings.accent_color }});
  }

  .reviews-heart-divider-{{ section.id }}::after {
    background: linear-gradient(90deg, {{ section.settings.accent_color }}, transparent);
  }

  .reviews-heart-divider-{{ section.id }} svg {
    width: 16px;
    height: 16px;
    fill: {{ section.settings.accent_color }};
  }

  /* Side-by-side Carousel Track & Navigation Wrapper */
  .reviews-slider-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
  }

  .reviews-nav-btn-{{ section.id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .reviews-nav-btn-{{ section.id }}:hover {
    background: #ffffff;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
    color: {{ section.settings.accent_color }};
  }

  .reviews-nav-prev-{{ section.id }} {
    left: -20px;
  }

  .reviews-nav-next-{{ section.id }} {
    right: -20px;
  }

  @media screen and (max-width: 749px) {
    .reviews-nav-prev-{{ section.id }} {
      left: -5px;
    }
    .reviews-nav-next-{{ section.id }} {
      right: -5px;
    }
  }

  .reviews-slider-track-{{ section.id }} {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 0.4rem 2rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    user-select: none;
  }

  .reviews-slider-track-{{ section.id }}:active {
    cursor: grabbing;
  }

  .reviews-slider-track-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .review-card-{{ section.id }} {
    flex: 0 0 calc(25% - 1.5rem);
    min-width: 280px;
    scroll-snap-align: start;
    background: #ffffff;
    border-radius: 16px;
    padding: 2.5rem 2rem;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  @media screen and (max-width: 1100px) {
    .review-card-{{ section.id }} {
      flex: 0 0 calc(45% - 1rem);
    }
  }

  @media screen and (max-width: 650px) {
    .review-card-{{ section.id }} {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }
  }

  .review-card-{{ section.id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.09);
  }

  .review-stars-{{ section.id }} {
    color: #d4a359;
    font-size: 1.8rem;
    letter-spacing: 0.2rem;
    margin-bottom: 1.2rem;
  }

  .review-headline-{{ section.id }} {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .review-body-{{ section.id }} {
    font-size: 1.4rem;
    line-height: 1.6;
    color: #555555;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .review-author-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    text-align: left;
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .review-avatar-{{ section.id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid {{ section.settings.accent_color }};
  }

  .review-author-info-{{ section.id }} {
    display: flex;
    flex-direction: column;
  }

  .review-author-name-{{ section.id }} {
    font-weight: 700;
    font-size: 1.45rem;
    color: #1a1a1a;
  }

  .review-verified-{{ section.id }} {
    font-size: 1.2rem;
    color: #2b8a3e;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }

  .review-verified-{{ section.id }} svg {
    width: 14px;
    height: 14px;
    fill: #2b8a3e;
  }
{%- endstyle -%}

<div class="reviews-carousel-bg-{{ section.id }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="reviews-header-{{ section.id }}">
      {%- if section.settings.subtitle != blank -%}
        <div class="reviews-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="reviews-title-{{ section.id }}">{{ section.settings.title }}</h2>
      {%- endif -%}
      <div class="reviews-heart-divider-{{ section.id }}">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </div>
    </div>

    <div class="reviews-slider-wrapper-{{ section.id }}">
      <button class="reviews-nav-btn-{{ section.id }} reviews-nav-prev-{{ section.id }}" aria-label="Previous review">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>

      <div class="reviews-slider-track-{{ section.id }}" id="reviews-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="review-card-{{ section.id }}" {{ block.shopify_attributes }}>
            <div class="review-stars-{{ section.id }}">
              ★★★★★
            </div>
            {%- if block.settings.headline != blank -%}
              <div class="review-headline-{{ section.id }}">“{{ block.settings.headline }}”</div>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="review-body-{{ section.id }}">{{ block.settings.body }}</div>
            {%- endif -%}
            <div class="review-author-{{ section.id }}">
              {%- if block.settings.author_image != blank -%}
                {{ block.settings.author_image | image_url: width: 100 | image_tag: class: 'review-avatar-banner', loading: 'lazy' }}
              {%- else -%}
                <img class="review-avatar-{{ section.id }}" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" alt="{{ block.settings.author_name }}" width="48" height="48" loading="lazy">
              {%- endif -%}
              <div class="review-author-info-{{ section.id }}">
                <div class="review-author-name-{{ section.id }}">{{ block.settings.author_name }}</div>
                <div class="review-verified-{{ section.id }}">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                  Verified Buyer
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <button class="reviews-nav-btn-{{ section.id }} reviews-nav-next-{{ section.id }}" aria-label="Next review">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.getElementById('reviews-track-{{ section.id }}');
    const prevBtn = document.querySelector('.reviews-nav-prev-{{ section.id }}');
    const nextBtn = document.querySelector('.reviews-nav-next-{{ section.id }}');

    if (!track) return;

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -340, behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: 340, behavior: 'smooth' });
      });
    }

    // Touch & Mouse Drag Sliding
    let isDown = false;
    let startX;
    let scrollLeft;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => {
      isDown = false;
    });

    track.addEventListener('mouseup', () => {
      isDown = false;
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.8;
      track.scrollLeft = scrollLeft - walk;
    });
  });
</script>

{% schema %}
{
  "name": "Customer Reviews Carousel",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "REAL LOVE, REAL REVIEWS"
    },
    {
      "type": "text",
