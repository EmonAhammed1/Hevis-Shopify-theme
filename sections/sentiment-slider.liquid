{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .sentiment-slider--{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .sentiment-slider .glass-ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .sentiment-slider .glass-ambient-orb--1 {
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, #f3d4a0 0%, #e2b472 100%);
    top: -50px;
    left: 10%;
  }

  .sentiment-slider .glass-ambient-orb--2 {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, #e6c587 0%, #c69a47 100%);
    bottom: -80px;
    right: 15%;
  }

  .sentiment-slider .glass-ambient-orb--3 {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, #f5e1bd 0%, #d4af37 100%);
    top: 25%;
    left: 55%;
  }

  .sentiment-slider--{{ section.id }} .page-width {
    position: relative;
    z-index: 2;
  }

  .sentiment-slider--{{ section.id }} .sentiment-slider__title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    color: {{ section.settings.heading_color }};
    letter-spacing: 0.08em;
  }

  .sentiment-slider--{{ section.id }} .sentiment-slider__line {
    background-color: {{ section.settings.accent_color }};
  }

  .sentiment-slider--{{ section.id }} .sentiment-slider__heart-icon {
    color: {{ section.settings.accent_color }};
  }

  .sentiment-slider--{{ section.id }} .sentiment-card__title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.card_title_size | default: 2.3 }}rem;
    margin-bottom: 0.4rem;
  }

  .sentiment-slider--{{ section.id }} .sentiment-card__subtitle {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.card_subtitle_size | default: 1.6 }}rem;
    color: {{ section.settings.subtitle_color }};
    opacity: 0.95;
    font-weight: 450;
  }

  /* Hide Navigation Arrows & Dots completely */
  .sentiment-slider .splide__dots-and-arrows,
  .sentiment-slider .splide__arrows,
  .sentiment-slider .splide__arrow,
  .sentiment-slider .splide__pagination {
    display: none !important;
  }

  /* Prevent side/top clipping when hovered card grows */
  .sentiment-slider .page-width {
    overflow: hidden !important;
    position: relative;
    z-index: 2;
  }

  .sentiment-slider .splide__track {
    overflow: visible !important;
    position: relative;
    padding-top: 15px !important;
    padding-bottom: 25px !important;
    cursor: grab;
  }

  .sentiment-slider .splide__track:active {
    cursor: grabbing;
  }

  .sentiment-slider .splide__list {
    display: flex !important;
    gap: 24px !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
    will-change: transform;
    width: max-content !important;
  }

  /* Frosted Glassmorphism Card Effect & Hover Grow */
  .sentiment-card {
    width: 280px !important;
    flex-shrink: 0 !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0.12) 100%) !important;
    backdrop-filter: blur(25px) saturate(200%) !important;
    -webkit-backdrop-filter: blur(25px) saturate(200%) !important;
    border-radius: 24px !important;
    padding: 1.4rem 1.4rem 2rem 1.4rem !important;
    border: 1px solid rgba(255, 255, 255, 0.65) !important;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08), inset 0 1px 2px rgba(255, 255, 255, 0.8), 0 0 0 1.5px rgba(198, 154, 71, 0.4) !important;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease, background 0.4s ease !important;
    cursor: pointer;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .sentiment-card:hover {
    transform: translateY(-12px) scale(1.08) !important;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.75) 0%, rgba(255, 255, 255, 0.35) 100%) !important;
    backdrop-filter: blur(30px) saturate(220%) !important;
    -webkit-backdrop-filter: blur(30px) saturate(220%) !important;
    border-color: rgba(255, 255, 255, 0.9) !important;
    box-shadow: 0 25px 55px rgba(198, 154, 71, 0.35), inset 0 1px 3px rgba(255, 255, 255, 1), 0 0 0 2px #c69a47 !important;
    z-index: 50 !important;
  }
{%- endstyle -%}

<div class="sentiment-slider sentiment-slider--{{ section.id }} section-{{ section.id }}-padding {{ section.settings.visibility }}">
  <div class="glass-ambient-orb glass-ambient-orb--1"></div>
  <div class="glass-ambient-orb glass-ambient-orb--2"></div>
  <div class="glass-ambient-orb glass-ambient-orb--3"></div>
  <div class="page-width">
    
    {% comment %} Section Header {% endcomment %}
    {%- if section.settings.title != blank -%}
      <div class="sentiment-slider__header text-center">
        <h2 class="sentiment-slider__title {{ section.settings.heading_size }} text-uppercase">
          {{ section.settings.title | escape }}
        </h2>
        {%- if section.settings.show_divider -%}
          <div class="sentiment-slider__divider-wrapper">
            <span class="sentiment-slider__line"></span>
            <span class="sentiment-slider__heart-icon">
              <svg width="18" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </span>
            <span class="sentiment-slider__line"></span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% comment %} Continuous Non-stop Smooth Marquee Ticker Slider {% endcomment %}
    <div class="sentiment-slider__marquee-container">
      <div class="splide">
        <div class="splide__track">
          <ul class="splide__list">
            {%- for block in section.blocks -%}
              <li class="splide__slide sentiment-card" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="sentiment-card__link">
                  <div class="sentiment-card__image-wrapper">
                    {%- if block.settings.image != blank -%}
                      <img
                        src="{{ block.settings.image | image_url: width: 800 }}"
                        alt="{{ block.settings.title | default: section.settings.title | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        class="sentiment-card__image"
                      >
                    {%- else -%}
                      {% assign default_img_idx = forloop.index | modulus: 4 %}
                      {% if default_img_idx == 1 %}
                        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=800&auto=format&fit=crop" class="sentiment-card__image" loading="lazy" width="800" height="800" alt="Wife Gift">
                      {% elsif default_img_idx == 2 %}
                        <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?q=80&w=800&auto=format&fit=crop" class="sentiment-card__image" loading="lazy" width="800" height="800" alt="Girlfriend Gift">
                      {% elsif default_img_idx == 3 %}
                        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?q=80&w=800&auto=format&fit=crop" class="sentiment-card__image" loading="lazy" width="800" height="800" alt="Mom Gift">
                      {% else %}
                        <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=800&auto=format&fit=crop" class="sentiment-card__image" loading="lazy" width="800" height="800" alt="Birthday Gift">
                      {% endif %}
                    {%- endif -%}
                  </div>

                  <div class="sentiment-card__content text-center">
                    {%- if block.settings.title != blank -%}
                      <h3 class="sentiment-card__title">
                        {{ block.settings.title | escape }}
                      </h3>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      <p class="sentiment-card__subtitle">
                        {{ block.settings.subtitle | escape }}
                      </p>
                    {%- endif -%}
                  </div>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    function initContinuousMarqueeEngine() {
      const section = document.querySelector('.sentiment-slider--{{ section.id }}');
      if (!section) return;

      const track = section.querySelector('.splide__track');
      const list = section.querySelector('.splide__list');
      if (!track || !list) return;

      // Duplicate cards to guarantee 100% infinite seamless continuous loop
      if (!list.dataset.cloned) {
        list.dataset.cloned = 'true';
        const originalCards = Array.from(list.children);
        // Duplicate twice for ultra smooth scrolling on wide screens
        originalCards.forEach(card => {
          list.appendChild(card.cloneNode(true));
        });
        originalCards.forEach(card => {
          list.appendChild(card.cloneNode(true));
        });
      }

      let currentX = 0;
      let isPaused = false;
      let isDragging = false;
      let startX = 0;
      let dragStartX = 0;
      let animationFrameId = null;

      // Speed: 0.75px per frame for silky smooth non-stop continuous gliding right-to-left
      const speed = 0.85;

      function step() {
        if (!isPaused && !isDragging) {
          currentX -= speed;
          // Calculate loop boundary (1/3 of total width since cloned twice)
          const loopBoundary = list.scrollWidth / 3;
          if (Math.abs(currentX) >= loopBoundary) {
            currentX += loopBoundary;
          }
          list.style.transform = 'translate3d(' + currentX + 'px, 0, 0)';
        }
        animationFrameId = requestAnimationFrame(step);
      }

      // Mouse hover pause & card grow
      section.addEventListener('mouseenter', function() {
        isPaused = true;
      });

      section.addEventListener('mouseleave', function() {
        if (!isDragging) {
          isPaused = false;
        }
      });

      // Mouse drag support
      track.addEventListener('mousedown', function(e) {
        isDragging = true;
        isPaused = true;
        startX = e.pageX;
        dragStartX = currentX;
        track.style.cursor = 'grabbing';
      });

      window.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        const diff = e.pageX - startX;
        currentX = dragStartX + diff;
        list.style.transform = 'translate3d(' + currentX + 'px, 0, 0)';
      });

      window.addEventListener('mouseup', function() {
        if (isDragging) {
          isDragging = false;
          track.style.cursor = 'grab';
          setTimeout(function() {
            isPaused = false;
          }, 400);
        }
      });

      // Touch swipe support for mobile devices
      track.addEventListener('touchstart', function(e) {
        isDragging = true;
        isPaused = true;
        startX = e.touches[0].pageX;
        dragStartX = currentX;
      }, { passive: true });

      track.addEventListener('touchmove', function(e) {
        if (!isDragging) return;
        const diff = e.touches[0].pageX - startX;
        currentX = dragStartX + diff;
        list.style.transform = 'translate3d(' + currentX + 'px, 0, 0)';
      }, { passive: true });

      track.addEventListener('touchend', function() {
        isDragging = false;
        setTimeout(function() {
          isPaused = false;
        }, 400);
      });

      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
      }
      animationFrameId = requestAnimationFrame(step);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContinuousMarqueeEngine);
    } else {
      initContinuousMarqueeEngine();
    }
  })();
</script>

<style>
  .sentiment-slider {
    position: relative;
    width: 100%;
  }

  .sentiment-slider__header {
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sentiment-slider__title {
    margin: 0 0 1rem 0;
    text-transform: uppercase;
  }

  .sentiment-slider__divider-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .sentiment-slider__line {
    height: 1.5px;
    width: 50px;
    opacity: 0.9;
  }

  .sentiment-slider__heart-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sentiment-slider .splide {
    overflow: visible !important;
  }

  .sentiment-slider .splide__track {
    padding-top: 16px !important;
    padding-bottom: 24px !important;
    padding-left: 12px !important;
    padding-right: 12px !important;
    margin-top: -16px !important;
    margin-bottom: -24px !important;
    margin-left: -12px !important;
    margin-right: -12px !important;
    overflow: visible !important;
    cursor: grab;
  }

  .sentiment-slider .splide__track:active {
    cursor: grabbing;
  }

  .sentiment-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255, 255, 255, 0.15) !important;
    backdrop-filter: blur(12px) saturate(160%) !important;
    -webkit-backdrop-filter: blur(12px) saturate(160%) !important;
    border-radius: 24px !important;
    padding: 1.4rem 1.4rem 2rem 1.4rem !important;
    border: 1.5px solid {{ section.settings.card_border_color | default: section.settings.accent_color | default: "#c69a47" }} !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04), inset 0 1px 2px rgba(255, 255, 255, 0.7), inset 0 -1px 2px rgba(0, 0, 0, 0.02) !important;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    cursor: pointer;
    box-sizing: border-box;
    height: 100%;
    position: relative;
  }

  .sentiment-card:hover {
    transform: translateY(-8px) scale(1.03) !important;
    background: rgba(255, 255, 255, 0.32) !important;
    backdrop-filter: blur(16px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
    border-color: {{ section.settings.accent_color | default: "#c69a47" }} !important;
    box-shadow: 0 18px 42px rgba(198, 154, 71, 0.25), inset 0 1px 3px rgba(255, 255, 255, 0.9) !important;
    z-index: 10;
  }

  .sentiment-card__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
  }

  .sentiment-card__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1.4rem;
    background-color: rgba(0, 0, 0, 0.03);
  }

  .sentiment-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 14px;
  }

  .sentiment-card:hover .sentiment-card__image {
    transform: scale(1.04);
  }

  .sentiment-card__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .sentiment-card__title {
    margin: 0;
    line-height: 1.3;
  }

  .sentiment-card__subtitle {
    margin: 0;
    line-height: 1.4;
    opacity: 0.95;
  }

  /* Slider Navigation Arrows Styling */
  .sentiment-slider .splide__arrow {
    background: rgba(0, 0, 0, 0.08) !important;
    color: #333333 !important;
    border: none !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    transition: all 0.3s ease !important;
    opacity: 0.85 !important;
  }

  .sentiment-slider .splide__arrow:hover {
    background: rgba(0, 0, 0, 0.16) !important;
    opacity: 1 !important;
    transform: translateY(-50%) scale(1.08) !important;
  }

  @media screen and (max-width: 749px) {
    .sentiment-card__image-wrapper {
      border-radius: 12px;
      margin-bottom: 1.2rem;
    }
    .sentiment-card__image {
      border-radius: 12px;
    }
    .sentiment-card__title {
      font-size: 1.5rem;
    }
    .sentiment-card__subtitle {
      font-size: 1.25rem;
    }
  }
</style>

{% schema %}
{
  "name": "Shop By Sentiment Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SHOP BY SENTIMENT"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Heart Line Divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Typography & Sizes"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 1.5,
      "max": 3.5,
      "step": 0.1,
      "unit": "rem",
      "label": "Card Title Size",
      "default": 2.3
    },
    {
      "type": "range",
      "id": "card_subtitle_size",
      "min": 1.2,
      "max": 2.5,
      "step": 0.1,
      "unit": "rem",
      "label": "Card Subtitle Size",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Autoplay & Slider Options"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay (Auto-rotate slides)",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "unit": "sec",
      "label": "Autoplay Speed (Seconds)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#faf7f2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & Card Title Color",
      "default": "#1a1612"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666055"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold Accent Color",
      "default": "#c69a47"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#c69a47"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    },
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    }
  ],
  "blocks": [
    {
      "type": "sentiment_card",
      "name": "Sentiment Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "For Your Wife"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Celebrate your forever love"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Sentiment Slider",
      "blocks": [
        {
          "type": "sentiment_card",
          "settings": {
            "title": "For Your Wife",
            "subtitle": "Celebrate your forever love"
          }
        },
        {
          "type": "sentiment_card",
          "settings": {
            "title": "For Your Girlfriend",
            "subtitle": "A gift she'll cherish"
          }
        },
        {
          "type": "sentiment_card",
          "settings": {
            "title": "For Your Mom",
            "subtitle": "Thank her for everything"
          }
        },
        {
          "type": "sentiment_card",
          "settings": {
            "title": "Birthday Gifts",
            "subtitle": "Make her day extra special"
          }
        }
      ]
    }
  ]
}
{% endschema %}
