{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .image-features--{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .image-features--{{ section.id }} .image-features__subheading {
    font-family: var(--font-heading-family);
    color: {{ section.settings.accent_color }};
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  .image-features--{{ section.id }} .image-features__heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    color: {{ section.settings.heading_color }};
  }

  .image-features--{{ section.id }} .image-features__line {
    background-color: {{ section.settings.accent_color }};
  }

  .image-features--{{ section.id }} .image-features__heart-icon {
    color: {{ section.settings.accent_color }};
  }

  .image-features--{{ section.id }} .image-features__checkmark {
    color: {{ section.settings.accent_color }};
  }

  .image-features--{{ section.id }} .image-features__badge {
    border-color: {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
{%- endstyle -%}

<div class="image-features image-features--{{ section.id }} section-{{ section.id }}-padding {{ section.settings.visibility }}">
  <div class="page-width">
    <div class="image-features__grid {% if section.settings.layout == 'right' %}image-features__grid--reverse{% endif %}">
      
      {% comment %} Left Media Column {% endcomment %}
      <div class="image-features__media-col">
        <div class="image-features__media-wrapper">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              loading="lazy"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              class="image-features__image"
            >
          {%- else -%}
            <img
              src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=1000&auto=format&fit=crop"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
              width="1000"
              height="1000"
              class="image-features__image"
            >
          {%- endif -%}

          {%- if section.settings.show_badge -%}
            <div class="image-features__badge">
              <div class="image-features__badge-content">
                <svg class="image-features__badge-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span class="image-features__badge-text">{{ section.settings.badge_text | default: "PREMIUM<br>QUALITY" }}</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      {% comment %} Right Content Column {% endcomment %}
      <div class="image-features__content-col">
        <div class="image-features__content">
          {%- if section.settings.subheading != blank -%}
            <span class="image-features__subheading text-uppercase">
              {{ section.settings.subheading | escape }}
            </span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="image-features__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.show_divider -%}
            <div class="image-features__divider-wrapper">
              <span class="image-features__line"></span>
              <span class="image-features__heart-icon">
                <svg width="18" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </span>
              <span class="image-features__line"></span>
            </div>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="image-features__description rte">
              {{ section.settings.description }}
            </div>
          {%- endif -%}

          {% comment %} Feature Checklist Items {% endcomment %}
          <div class="image-features__list">
            {%- for block in section.blocks -%}
              <div class="image-features__list-item" {{ block.shopify_attributes }}>
                <span class="image-features__checkmark">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="9 12 11.5 14.5 15.5 9.5"></polyline>
                  </svg>
                </span>
                <span class="image-features__list-text">
                  {{ block.settings.text | escape }}
                </span>
              </div>
            {%- endfor -%}
          </div>

          {%- if section.settings.button_label != blank -%}
            <div class="image-features__button-wrapper">
              <a href="{{ section.settings.button_link }}" class="button button--primary">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .image-features {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .image-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media screen and (max-width: 749px) {
    .image-features__content {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .image-features__subheading {
      text-align: center;
    }
    .image-features__heading {
      text-align: center;
    }
    .image-features__divider-wrapper {
      margin-left: auto;
      margin-right: auto;
      justify-content: center;
    }
    .image-features__description {
      text-align: center;
    }
    .image-features__list {
      align-items: flex-start;
      display: inline-flex;
    }
    .image-features__button-wrapper {
      width: 100%;
      display: flex;
      justify-content: center;
    }
  }

  @media screen and (min-width: 990px) {
    .image-features__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 6rem;
    }

    .image-features__grid--reverse {
      grid-template-columns: 1fr 1.1fr;
    }

    .image-features__grid--reverse .image-features__media-col {
      order: 2;
    }
  }

  .image-features__media-col {
    position: relative;
    width: 100%;
  }

  .image-features__media-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  .image-features__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .image-features__media-wrapper:hover .image-features__image {
    transform: scale(1.02);
  }

  /* Round Stamp Badge in Bottom-Left of Image */
  .image-features__badge {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    z-index: 2;
  }

  .image-features__badge-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  .image-features__badge-icon {
    margin-bottom: 0.2rem;
  }

  .image-features__badge-text {
    font-family: var(--font-heading-family);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Content Column Styles */
  .image-features__content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .image-features__subheading {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin-bottom: 0.8rem;
  }

  .image-features__heading {
    margin: 0 0 1.2rem 0;
    line-height: 1.25;
  }

  /* Heart Line Divider */
  .image-features__divider-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.8rem;
    width: max-content;
    max-width: 100%;
  }

  .image-features__line {
    height: 1.5px;
    width: 60px;
    opacity: 0.9;
  }

  .image-features__heart-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-features__description {
    font-family: var(--font-body-family);
    font-size: 1.8rem;
    font-weight: 450;
    line-height: 1.6;
    margin-bottom: 2.4rem;
    opacity: 1;
    color: inherit;
  }

  /* Checklist Items */
  .image-features__list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .image-features__list-item {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .image-features__checkmark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .image-features__list-text {
    font-family: var(--font-body-family);
    font-size: 1.7rem;
    font-weight: 550;
    line-height: 1.4;
    opacity: 1;
    color: inherit;
  }

  .image-features__button-wrapper {
    margin-top: 1rem;
  }

  @media screen and (max-width: 749px) {
    .image-features__badge {
      width: 80px;
      height: 80px;
      bottom: 1.2rem;
      left: 1.2rem;
    }
    .image-features__badge-text {
      font-size: 0.75rem;
    }
    .image-features__description {
      font-size: 1.4rem;
    }
    .image-features__list-text {
      font-size: 1.35rem;
    }
  }
</style>

{% schema %}
{
  "name": "Product Highlight Feature",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "left", "label": "Image on Left" },
        { "value": "right", "label": "Image on Right" }
      ],
      "default": "left",
      "label": "Image Desktop Alignment"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Circular Stamp Badge on Image",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "PREMIUM QUALITY"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "TIMELESS BEAUTY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Than Just a Necklace"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Heart Line Divider",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Each piece is crafted with precision and care, symbolizing a love that lasts forever.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1612"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#332d26"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold Accent Color",
      "default": "#c69a47"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    },
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Checklist Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Elegant heart design with a sparkling diamond"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Highlight Feature",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "text": "Elegant heart design with a sparkling diamond"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "text": "Crafted with premium materials"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "text": "Comes with a beautiful message card"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "text": "Hypoallergenic & comfortable for daily wear"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "text": "A timeless keepsake she'll treasure always"
          }
        }
      ]
    }
  ]
}
{% endschema %}
