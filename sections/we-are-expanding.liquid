      "default": true
    },
    {
      "type": "text",
      "id": "tag_1",
      "label": "Tag 1 Text",
      "default": "New Keepsake Designs"
    },
    {
      "type": "text",
      "id": "tag_2",
      "label": "Tag 2 Text",
      "default": "Sentimental Card Drops"
    },
    {
      "type": "text",
      "id": "tag_3",
      "label": "Tag 3 Text",
      "default": "Exclusive Releases"
    },
    {
      "type": "header",
