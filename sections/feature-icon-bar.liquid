{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .feature-icon-bar--{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__title {
    color: {{ section.settings.text_color }};
    font-family: {% if section.settings.heading_font == 'serif' %}Georgia, "Times New Roman", serif{% else %}inherit{% endif %};
    letter-spacing: 0.12em;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__title-underline {
    background-color: {{ section.settings.underline_color }};
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__item-title {
    color: {{ section.settings.text_color }};
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__item-subtitle {
    color: {{ section.settings.subtitle_color }};
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon {
    color: {{ section.settings.icon_color }};
    width: {{ section.settings.icon_size_desktop }}px;
    height: {{ section.settings.icon_size_desktop }}px;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon svg,
  .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  {% if section.settings.show_dividers %}
    @media screen and (min-width: 750px) {
      .feature-icon-bar--{{ section.id }} .feature-icon-bar__item:not(:last-child) {
        border-right: 1px solid {{ section.settings.divider_color }};
      }
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="feature-icon-bar feature-icon-bar--{{ section.id }} section-{{ section.id }}-padding {{ section.settings.visibility }}">
  <div class="{% if section.settings.full_width %}full-width{% else %}page-width{% endif %}">
    {%- if section.settings.title != blank -%}
      <div class="feature-icon-bar__header text-{{ section.settings.title_alignment }}">
        <h2 class="feature-icon-bar__title {{ section.settings.heading_size }}">
          {{ section.settings.title | escape }}
        </h2>
        {%- if section.settings.show_underline -%}
          <div class="feature-icon-bar__title-underline"></div>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="feature-icon-bar__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="feature-icon-bar__grid feature-icon-bar__grid--desktop-{{ section.settings.columns_desktop }} feature-icon-bar__grid--mobile-{{ section.settings.mobile_layout }}">
      {%- for block in section.blocks -%}
        <div class="feature-icon-bar__item text-center" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="feature-icon-bar__link">
          {%- endif -%}

          <div class="feature-icon-bar__icon-wrapper">
            <div class="feature-icon-bar__icon">
              {%- if block.settings.custom_icon != blank -%}
                <img
                  src="{{ block.settings.custom_icon | image_url: width: 300 }}"
                  alt="{{ block.settings.custom_icon.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.custom_icon.width }}"
                  height="{{ block.settings.custom_icon.height }}"
                >
              {%- elsif block.settings.icon != blank -%}
                {% render 'material-icon', icon: block.settings.icon, filled: false %}
              {%- else -%}
                {% render 'material-icon', icon: 'stars', filled: false %}
              {%- endif -%}
            </div>
          </div>

          <div class="feature-icon-bar__content">
            {%- if block.settings.title != blank -%}
              <h3 class="feature-icon-bar__item-title">
                {{ block.settings.title | escape }}
              </h3>
            {%- endif -%}

            {%- if block.settings.subtitle != blank -%}
              <p class="feature-icon-bar__item-subtitle">
                {{ block.settings.subtitle | escape }}
              </p>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .feature-icon-bar {
    position: relative;
    width: 100%;
  }

  .feature-icon-bar__header {
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .feature-icon-bar__header.text-left {
    align-items: flex-start;
  }

  .feature-icon-bar__header.text-right {
    align-items: flex-end;
  }

  .feature-icon-bar__title {
    margin: 0 0 1rem 0;
    text-transform: uppercase;
    font-weight: 600;
    font-size: 2.2rem;
    line-height: 1.3;
  }

  .feature-icon-bar__title-underline {
    width: 60px;
    height: 2px;
    margin-top: 0.2rem;
    border-radius: 2px;
  }

  .feature-icon-bar__grid {
    display: grid;
    width: 100%;
    align-items: flex-start;
  }

  @media screen and (min-width: 750px) {
    .feature-icon-bar__grid--desktop-1 { grid-template-columns: 1fr; }
    .feature-icon-bar__grid--desktop-2 { grid-template-columns: repeat(2, 1fr); }
    .feature-icon-bar__grid--desktop-3 { grid-template-columns: repeat(3, 1fr); }
    .feature-icon-bar__grid--desktop-4 { grid-template-columns: repeat(4, 1fr); }
    .feature-icon-bar__grid--desktop-5 { grid-template-columns: repeat(5, 1fr); }
    .feature-icon-bar__grid--desktop-6 { grid-template-columns: repeat(6, 1fr); }
  }

  @media screen and (max-width: 749px) {
    .feature-icon-bar__grid--mobile-1 { grid-template-columns: 1fr; row-gap: 2.5rem; }
    .feature-icon-bar__grid--mobile-2 { grid-template-columns: repeat(2, 1fr); gap: 2rem 1rem; }
    .feature-icon-bar__grid--mobile-scroll {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1.5rem;
      padding-bottom: 1rem;
      -webkit-overflow-scrolling: touch;
    }
    .feature-icon-bar__grid--mobile-scroll .feature-icon-bar__item {
      flex: 0 0 75%;
      scroll-snap-align: center;
    }
  }

  .feature-icon-bar__item {
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .feature-icon-bar__item:hover {
    transform: translateY(-3px);
  }

  .feature-icon-bar__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .feature-icon-bar__icon-wrapper {
    margin-bottom: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-icon-bar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .feature-icon-bar__icon svg {
    fill: currentColor;
  }

  .feature-icon-bar__item-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.4rem 0;
    line-height: 1.3;
  }

  .feature-icon-bar__item-subtitle {
    font-size: 1.25rem;
    margin: 0;
    opacity: 0.85;
    line-height: 1.4;
  }
</style>

{% schema %}
{
  "name": "Feature Icon Bar",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MADE TO CELEBRATE LOVE"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading Font Style",
      "options": [
        { "value": "serif", "label": "Serif / Luxury Elegance" },
        { "value": "sans", "label": "Sans-Serif Standard" }
      ],
      "default": "serif"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_underline",
      "label": "Show Underline Accent Line",
      "default": true
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline Accent Color",
      "default": "#dfb256"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        { "value": "1", "label": "1 Column per row" },
        { "value": "2", "label": "2 Columns per row" },
        { "value": "scroll", "label": "Horizontal Carousel / Scroll" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show Vertical Dividers Between Items",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Vertical Divider Color",
      "default": "rgba(0, 0, 0, 0.08)"
    },
    {
      "type": "header",
      "content": "Colors & Customization"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf7f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & Text Color",
      "default": "#2b261f"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666055"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Material Icon Color",
      "default": "#a67c42"
    },
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Icon Size (Desktop)",
      "default": 44
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Icon Size (Mobile)",
      "default": 36
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    },
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (PNG, SVG, WEBP)"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Material Icon Name (Fallback)",
          "default": "diamond",
          "info": "Used if no custom icon image is uploaded. E.g. diamond, card_giftcard, verified, shield, stars, local_shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Dazzling Diamond"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Brilliant & Elegant"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Icon Bar",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "icon": "diamond",
            "title": "Dazzling Diamond",
            "subtitle": "Brilliant & Elegant"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "card_giftcard",
            "title": "Luxury Gift Box",
            "subtitle": "Ready to Impress"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "mail",
            "title": "Heartfelt Message Card",
            "subtitle": "Included Inside"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "shield",
            "title": "Tarnish Resistant",
            "subtitle": "Built to Last"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "verified",
            "title": "Satisfaction Guarantee",
            "subtitle": "30-Day Promise"
          }
        }
      ]
    }
  ]
}
{% endschema %}
