{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .color-scheme-{{ section.id }}.color-custom {
    --color-background: {{ section.settings.custom_colors_background.red }}, {{ section.settings.custom_colors_background.green }}, {{ section.settings.custom_colors_background.blue }};
    --gradient-background: {% if section.settings.custom_gradient_background != blank %}{{ section.settings.custom_gradient_background }}{% else %}{{ section.settings.custom_colors_background }}{% endif %};
    --color-foreground: {{ section.settings.custom_colors_text.red }}, {{ section.settings.custom_colors_text.green }}, {{ section.settings.custom_colors_text.blue }};
  }

  .feature-icon-bar--{{ section.id }} {
    background: var(--gradient-background, var(--color-background));
    color: var(--color-foreground);
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none !important;
    color: inherit;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__title-underline {
    background-color: {{ section.settings.underline_color }};
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center !important;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 0.8rem auto;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__content {
    text-align: center !important;
    width: 100%;
    margin: 0 auto;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__item-title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: {{ section.settings.title_font_size }}rem;
    color: inherit;
    text-align: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__item-subtitle {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.subtitle_font_size }}rem;
    color: {{ section.settings.subtitle_color }};
    text-align: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon {
    color: {{ section.settings.icon_color }};
    width: {{ section.settings.icon_size_desktop }}px;
    height: {{ section.settings.icon_size_desktop }}px;
  }

  .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon svg,
  .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  {% if section.settings.show_dividers %}
    @media screen and (min-width: 750px) {
      .feature-icon-bar--{{ section.id }} .feature-icon-bar__item:not(:last-child) {
        border-right: 1px solid {{ section.settings.divider_color }};
      }
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__icon {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__item-title {
      font-size: {{ section.settings.title_font_size | times: 0.88 }}rem;
    }
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__item-subtitle {
      font-size: {{ section.settings.subtitle_font_size | times: 0.9 }}rem;
    }
  }
{%- endstyle -%}

<div class="color-scheme-{{ section.id }} color-{{ section.settings.color_scheme }} gradient feature-icon-bar feature-icon-bar--{{ section.id }} section-{{ section.id }}-padding {{ section.settings.visibility }}">
  <div class="{% if section.settings.full_width %}full-width{% else %}page-width{% endif %}">
    {%- if section.settings.title != blank -%}
      <div class="feature-icon-bar__header text-{{ section.settings.title_alignment }}">
        <h2 class="feature-icon-bar__title {{ section.settings.heading_size }} title-with-highlight" style="--hightlight-color: {{ section.settings.underline_color }}">
          {{ section.settings.title | escape }}
        </h2>
        {%- if section.settings.show_underline -%}
          <div class="feature-icon-bar__title-underline"></div>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="feature-icon-bar__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% comment %} DESKTOP GRID (Exact Original) {% endcomment %}
    <div class="feature-icon-bar__grid feature-icon-bar__grid--desktop-{{ section.settings.columns_desktop }} feature-icon-bar__desktop-only">
      {%- for block in section.blocks -%}
        <div class="feature-icon-bar__item text-center" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="feature-icon-bar__link">
          {%- endif -%}

          <div class="feature-icon-bar__icon-wrapper">
            <div class="feature-icon-bar__icon">
              {%- if block.settings.custom_icon != blank -%}
                <img
                  src="{{ block.settings.custom_icon | image_url: width: 300 }}"
                  alt="{{ block.settings.custom_icon.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.custom_icon.width }}"
                  height="{{ block.settings.custom_icon.height }}"
                >
              {%- elsif block.settings.icon != blank -%}
                {% render 'material-icon', icon: block.settings.icon, filled: false %}
              {%- else -%}
                {% render 'material-icon', icon: 'stars', filled: false %}
              {%- endif -%}
            </div>
          </div>

          <div class="feature-icon-bar__content">
            {%- if block.settings.title != blank -%}
              <h3 class="feature-icon-bar__item-title">
                {{ block.settings.title | escape }}
              </h3>
            {%- endif -%}

            {%- if block.settings.subtitle != blank -%}
              <p class="feature-icon-bar__item-subtitle">
                {{ block.settings.subtitle | escape }}
              </p>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {% comment %} MOBILE SLIDER {% endcomment %}
    <splide-component
      class="feature-icon-bar__mobile-only"
      data-type="slide"
      data-slides-mobile="{% if section.settings.mobile_layout == '1' %}1{% else %}2{% endif %}"
      data-gap-mobile="15"
      data-side-padding-mobile="15"
      data-destroy-desktop="true"
    >
      <div class="splide splide--mobile-dots-bottom splide--mobile-arrows-none">
        <div class="splide__track">
          <ul class="splide__list" style="margin: 0; padding: 0; list-style: none;">
            {%- for block in section.blocks -%}
              <li class="splide__slide feature-icon-bar__item text-center" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="feature-icon-bar__link">
                {%- endif -%}

                <div class="feature-icon-bar__icon-wrapper">
                  <div class="feature-icon-bar__icon">
                    {%- if block.settings.custom_icon != blank -%}
                      <img
                        src="{{ block.settings.custom_icon | image_url: width: 300 }}"
                        alt="{{ block.settings.custom_icon.alt | default: block.settings.title | escape }}"
                        loading="lazy"
                        width="{{ block.settings.custom_icon.width }}"
                        height="{{ block.settings.custom_icon.height }}"
                      >
                    {%- elsif block.settings.icon != blank -%}
                      {% render 'material-icon', icon: block.settings.icon, filled: false %}
                    {%- else -%}
                      {% render 'material-icon', icon: 'stars', filled: false %}
                    {%- endif -%}
                  </div>
                </div>

                <div class="feature-icon-bar__content">
                  {%- if block.settings.title != blank -%}
                    <h3 class="feature-icon-bar__item-title">
                      {{ block.settings.title | escape }}
                    </h3>
                  {%- endif -%}

                  {%- if block.settings.subtitle != blank -%}
                    <p class="feature-icon-bar__item-subtitle">
                      {{ block.settings.subtitle | escape }}
                    </p>
                  {%- endif -%}
                </div>

                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
        <div class="splide__dots-and-arrows" style="margin-top: 2rem;">
          <ul class="splide__pagination"></ul>
          <div class="splide__arrows"></div>
        </div>
      </div>
    </splide-component>
  </div>
</div>

<style>
  .feature-icon-bar {
    position: relative;
    width: 100%;
  }

  .feature-icon-bar__header {
    margin-bottom: 3.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .feature-icon-bar__header.text-left {
    align-items: flex-start;
  }

  .feature-icon-bar__header.text-right {
    align-items: flex-end;
  }

  .feature-icon-bar__title {
    margin: 0 0 1rem 0;
    text-transform: uppercase;
  }

  .feature-icon-bar__title-underline {
    width: 70px;
    height: 2px;
    margin-top: 0.4rem;
    border-radius: 2px;
  }

  @media screen and (min-width: 750px) {
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__mobile-only {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__desktop-only {
      display: none !important;
    }
  }

  .feature-icon-bar__grid {
    display: grid;
    width: 100%;
    align-items: flex-start;
  }

  @media screen and (min-width: 750px) {
    .feature-icon-bar__grid--desktop-1 { grid-template-columns: 1fr; }
    .feature-icon-bar__grid--desktop-2 { grid-template-columns: repeat(2, 1fr); }
    .feature-icon-bar__grid--desktop-3 { grid-template-columns: repeat(3, 1fr); }
    .feature-icon-bar__grid--desktop-4 { grid-template-columns: repeat(4, 1fr); }
    .feature-icon-bar__grid--desktop-5 { grid-template-columns: repeat(5, 1fr); }
    .feature-icon-bar__grid--desktop-6 { grid-template-columns: repeat(6, 1fr); }
  }

  @media screen and (max-width: 749px) {
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__item {
      padding: 1rem 0.5rem 2rem 0.5rem !important;
      text-align: center !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__item-title,
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__item-subtitle,
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__content {
      text-align: center !important;
    }
    .feature-icon-bar--{{ section.id }} .feature-icon-bar__header {
      text-align: center !important;
      align-items: center !important;
    }
    .feature-icon-bar--{{ section.id }} .splide__arrows,
    .feature-icon-bar--{{ section.id }} .splide__arrow {
      display: none !important;
    }
    .feature-icon-bar--{{ section.id }} .splide__pagination {
      position: relative !important;
      bottom: auto !important;
      left: auto !important;
      transform: none !important;
      margin-top: 1rem !important;
      padding-top: 0.5rem !important;
      display: flex !important;
      justify-content: center !important;
      z-index: 2 !important;
    }
    .feature-icon-bar--{{ section.id }} .splide__dots-and-arrows {
      position: relative !important;
      bottom: auto !important;
      margin-top: 1rem !important;
      z-index: 2 !important;
    }
  }

  .feature-icon-bar__item {
    padding: 1.2rem 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .feature-icon-bar__item:hover {
    transform: translateY(-4px);
  }

  .feature-icon-bar__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .feature-icon-bar__icon-wrapper {
    margin-bottom: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-icon-bar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .feature-icon-bar__icon svg {
    fill: currentColor;
  }

  .feature-icon-bar__item-title {
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
    letter-spacing: 0.02em;
  }

  .feature-icon-bar__item-subtitle {
    margin: 0;
    opacity: 0.85;
    line-height: 1.45;
  }
</style>

{% schema %}
{
  "name": "Feature Icon Bar",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MADE TO CELEBRATE LOVE"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large (Hero Style)" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_underline",
      "label": "Show Underline Accent Line",
      "default": true
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline Accent Color",
      "default": "#dfb256"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Typography & Font Sizes"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 1.2,
      "max": 5.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Feature Item Title Font Size",
      "default": 2.4
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "min": 1.0,
      "max": 3.0,
      "step": 0.1,
      "unit": "rem",
      "label": "Feature Item Subtitle Font Size",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Icon Sizing"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Icon Size (Desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Icon Size (Mobile)",
      "default": 56
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        { "value": "1", "label": "1 Column per row" },
        { "value": "2", "label": "2 Columns per row" },
        { "value": "scroll", "label": "Horizontal Carousel / Scroll" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show Vertical Dividers Between Items",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Vertical Divider Color",
      "default": "rgba(0, 0, 0, 0.08)"
    },
    {
      "type": "header",
      "content": "Color Scheme & Theme Styling"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" },
        { "value": "custom", "label": "Custom Colors" }
      ],
      "default": "custom",
      "label": "Color Scheme"
    },
    {
      "type": "color",
      "id": "custom_colors_background",
      "label": "Custom Background Color",
      "default": "#faf7f2"
    },
    {
      "type": "color_background",
      "id": "custom_gradient_background",
      "label": "Custom Gradient Background"
    },
    {
      "type": "color",
      "id": "custom_colors_text",
      "label": "Custom Text Color",
      "default": "#2b261f"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#666055"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Material Icon Color",
      "default": "#a67c42"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 56
    },
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (PNG, SVG, WEBP)"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Material Icon Name (Fallback)",
          "default": "diamond",
          "info": "Used if no custom icon image is uploaded. E.g. diamond, card_giftcard, verified, shield, stars, local_shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Dazzling Diamond"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Brilliant & Elegant"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Icon Bar",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "icon": "diamond",
            "title": "Dazzling Diamond",
            "subtitle": "Brilliant & Elegant"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "card_giftcard",
            "title": "Luxury Gift Box",
            "subtitle": "Ready to Impress"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "mail",
            "title": "Heartfelt Message Card",
            "subtitle": "Included Inside"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "shield",
            "title": "Tarnish Resistant",
            "subtitle": "Built to Last"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "verified",
            "title": "Satisfaction Guarantee",
            "subtitle": "30-Day Promise"
          }
        }
      ]
    }
  ]
}
{% endschema %}
